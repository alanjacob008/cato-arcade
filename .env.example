# CATO Wrapped — environment.
# Copy to .env and fill in the (required) values. Everything else has a working
# default shown after the "=". NEXT_PUBLIC_* are read by the Next.js web app and
# are exposed to the browser; the rest are server-side (API + indexer).
#
# Note: tsx does NOT auto-load .env. Pass these when running locally, e.g.
#   set -a; . ./.env; set +a   (then `npm run ...`)
# On Heroku/Vercel set them as config vars.

# ============================ REQUIRED ============================

# --- Helius (Solana RPC + Enhanced Transactions) --- (required)
# Get a key at https://dashboard.helius.dev and paste it here.
HELIUS_API_KEY=your-helius-api-key-here

# --- Database --- (required)
# Heroku Postgres injects DATABASE_URL automatically in prod. For local use a
# localhost URL (the pool disables SSL for localhost/127.0.0.1).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/cato_wrapped

# ======================= SERVER (optional) ========================
# All have defaults; override only to change behavior.

# --- CATO token ---
CATO_MINT=5p2zjqCd1WJzAVgcEnjhb9zWDU7b9XVhFhx4usiyN7jB

# --- Gate --- (default 19417 = the original May-2021 airdrop amount, lore-perfect)
GATE_THRESHOLD=19417

# --- Broad-activity scan caps --- (default 10 / 10000)
BROAD_SCAN_MAX_PAGES=10
BROAD_SCAN_DISPLAY_CUTOFF=10000

# --- Indexer signature sweep --- (default 20)
# Per-ATA page cap (~pages x 1000 sigs). Bounds infrastructure ATAs (pools/CEX/
# distributors with 100k+ signatures) so they can't hang the index run.
INDEXER_MAX_SIG_PAGES=20

# --- Pricing (current bag USD) --- (default jupiter)
PRICE_SOURCE=jupiter

# --- Helius credit burn tracking (for the progress bar) --- (default 10000000 / 0)
HELIUS_CREDIT_BUDGET=10000000
# Set to the "credits used" figure from your Helius dashboard at start so the
# meter reflects true cumulative spend (e.g. 247311).
HELIUS_CREDITS_USED_START=0

# --- Swap backfill loop --- (default 10; set 0 to disable in-process backfill)
# How often (minutes) the server re-enriches swap rows that arrived with only a txid
# (mints/amounts/wallet are filled from Helius on-chain data). Set to 0 if you prefer
# to run the backfill as a standalone cron job (`npm run backfill-swaps` in apps/api).
SWAP_BACKFILL_INTERVAL_MIN=10

# --- Staking backend (stake-rewards program) ---
# Solana RPC for admin cron jobs (defaults to Helius mainnet).
STAKE_RPC_URL=https://mainnet.helius-rpc.com/?api-key=your-helius-api-key-here
STAKE_PROGRAM_ID=DEM7gtr1zbcUiHT7KkDpNaYgarNcMqYKiHLhXHZYxtgL
STAKE_CATO_MINT=5p2zjqCd1WJzAVgcEnjhb9zWDU7b9XVhFhx4usiyN7jB
STAKE_ADMIN_SECRET_KEY=
# Whole CATO moved admin → revenue vault each daily cron tick (default 100).
# The full vault balance is then split pro-rata across eligible stakers.
STAKE_REVENUE_TRANSFER_CATO=100
# Staking crons (in-process, IST): send-revenue 00:00, distribute-rewards 01:00.
# Requires STAKE_ADMIN_SECRET_KEY. Disable by leaving that key unset.

# --- API server --- (defaults 8080 / http://localhost:3000)
# Heroku injects PORT; API_PORT overrides it locally.
API_PORT=8080
# CORS allow-origin: MUST exactly match the web app's origin (scheme + host +
# port), e.g. http://localhost:3000 in dev or https://your-app.vercel.app in prod.
# A mismatch (e.g. web on :3001) makes the browser block API calls.
WEB_ORIGIN=http://localhost:3000

# ===================== WEB APP (Next.js) ==========================
# NEXT_PUBLIC_* are baked into the client bundle at build/start time.

# Base URL the web app calls for the API. (default http://localhost:8080)
NEXT_PUBLIC_API_URL=http://localhost:8080
# 1 = serve sample data without the backend (UI/branding iteration). (default 0)
NEXT_PUBLIC_DEMO=0
# Miniclip archery game URL (default http://localhost:5173 in dev).
NEXT_PUBLIC_MINICLIP_URL=http://localhost:5173

# --- Solana RPC (staking / wallet) ---
# The browser always uses the same-origin /api/rpc proxy. Keyed RPC URLs and API
# keys are server-only: set STAKE_RPC_URL (or HELIUS_API_KEY) on the Vercel *web*
# project. NEXT_PUBLIC_* values are inlined into public JavaScript, so the build
# refuses any NEXT_PUBLIC_* / VITE_* value or name that carries a credential.
# NEXT_PUBLIC_RPC_URL is optional and may only be a keyless public endpoint.
NEXT_PUBLIC_RPC_URL=
# Server-only (used by /api/rpc; does not need a client rebuild):
# STAKE_RPC_URL=https://mainnet.helius-rpc.com/?api-key=your-helius-api-key-here
# HELIUS_API_KEY=your-helius-api-key-here

# --- Jupiter swap fee capture (/swap) ---
# Leave the referral account blank to run swaps fee-free (the default).
# To COLLECT a fee:
#   1. Create a referral account at https://referral.jup.ag (or via
#      @jup-ag/referral-sdk against project DkiqsTrw1u1bYFumumC7sCG2S8K25qc2vemJFHyW2wJc).
#   2. Create a fee token account (ATA) for EACH mint you want fees in (start
#      with SOL + USDC). If the fee-mint ATA is missing, the swap still works but
#      collects nothing.
#   3. Set NEXT_PUBLIC_JUP_REFERRAL_ACCOUNT below. Fees accrue on-chain to your
#      referral accounts (you keep 80%, Jupiter takes 20%); claim via the dashboard.
NEXT_PUBLIC_JUP_REFERRAL_ACCOUNT=
# Integrator fee in basis points. Jupiter requires 50–255 (0.5%–2.55%);
# 50 = the smallest allowed. (default 50)
NEXT_PUBLIC_JUP_FEE_BPS=50

# =============================== Up Down game (apps/web + apps/updown) ===============================
# The Up / Down game is served inside the web app under /updown and gated behind a
# wallet sign-in (apps/web/middleware.ts, apps/web/app/api/updown/*). On Vercel the
# web build also builds the game (apps/web/scripts/build-updown.mjs) into
# apps/web/public/updown, and its round service runs as the site's own serverless
# routes (/game-api/*, plus the /api/updown/sweep cron in vercel.json) on Postgres.
#
# --- Server-only (never VITE_* / NEXT_PUBLIC_*) ---
# Vercel scopes: DATABASE_URL (and _UNPOOLED), UPDOWN_JOURNAL_KEY and CRON_SECRET are PRODUCTION ONLY.
# Preview deployments must never hold the production round database or key: mainnet play and the
# sweep are refused (503) on any deployment whose VERCEL_ENV is not "production". A preview that should
# play uses VITE_DEPLOYMENT_ENV=testnet with its OWN Preview-scoped DATABASE_URL and UPDOWN_JOURNAL_KEY.
# UPDOWN_ALLOW_PREVIEW_MAINNET=1 overrides the refusal (do not set it in normal use).
# UPDOWN_ALLOW_PREVIEW_MAINNET=
# HMAC secret for the beta session cookie. SECRET. Required in production; dev uses a fixed fallback.
UPDOWN_SESSION_SECRET=
# Whole CATO a wallet must hold to enter the private beta. Not secret. (default 50000)
UPDOWN_VIP_THRESHOLD=50000
# Mainnet RPC for the balance check. SECRET if it embeds an API key.
# (default: HELIUS_API_KEY mainnet URL, else public mainnet RPC)
UPDOWN_GATE_RPC_URL=
# Postgres for the round journal. SECRET, Production scope only. On Vercel, Storage -> Neon adds
# DATABASE_URL (the pooled URL is fine). Required for /game-api; tables are created on first use.
# Locally: a throwaway database, e.g. postgres://postgres@127.0.0.1:5432/updown_dev
# DATABASE_URL=
# Neon also adds DATABASE_URL_UNPOOLED (direct); migrations use it when present. SECRET.
# DATABASE_URL_UNPOOLED=
# TLS: verified for remote hosts (Neon's sslmode=require = verify-full in pg 8). Set
# PGSSL_NO_VERIFY=1 only for a provider with self-signed certificates (e.g. Heroku).
# Seals each round's delegated trading key in the database (AES-256-GCM). SECRET, Production scope only.
# 64 hex characters. Generate ONCE and never change it, or active rounds cannot close:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
UPDOWN_JOURNAL_KEY=
# Vercel Cron sends "Authorization: Bearer $CRON_SECRET" to /api/updown/sweep. SECRET, Production scope only.
# Any long random string; without it the sweep refuses every call.
CRON_SECRET=
# Optional: 0 = do not apply apps/updown/db/*.sql automatically (then run `npm run migrate` in apps/updown).
# UPDOWN_AUTO_MIGRATE=1
#
# --- Game build (Vercel: env available at BUILD time; all public, baked into the bundle) ---
# Same names as apps/updown/.env.example. The build forces VITE_BASE_URL=/updown/.
# VITE_ORDERLY_BROKER_ID and VITE_DEPLOYMENT_ENV are also read at runtime by the round service.
# VITE_DEPLOYMENT_ENV: "mainnet" or "testnet" only (trimmed, case-insensitive; unset = testnet). Any other
# value fails the build and the round service answers 503. Mainnet also needs VITE_DISABLE_MAINNET=false
# and VITE_DISABLE_TESTNET=true, or the build fails (the page could otherwise drift to testnet).
VITE_APP_NAME=Up Down
VITE_APP_DESCRIPTION="Pick a market. Pick a side. Make your moment."
VITE_ORDERLY_BROKER_NAME=Up Down
VITE_ORDERLY_BROKER_ID=demo
VITE_DEPLOYMENT_ENV=testnet
VITE_DISABLE_MAINNET=true
VITE_DISABLE_TESTNET=false
VITE_ENABLED_MENUS=Trading,Portfolio
VITE_SEO_SITE_NAME=Up Down
# The production site URL (default on Vercel: https://$VERCEL_PROJECT_PRODUCTION_URL).
VITE_SEO_SITE_URL=
VITE_WALLETCONNECT_PROJECT_ID=
VITE_SOLANA_RPC_URL=
# Header links back to the site: leave VITE_MAIN_SITE_URL unset on the web project (same origin).
# Build controls: UPDOWN_SKIP_BUILD=1 skips the game build (no bundle = "coming online
# soon" page and /game-api 503); it is also required to build the site without apps/updown in the
# checkout (otherwise the build fails). UPDOWN_BUILD_HEAP_MB=3072 is the Vite build heap.
# UPDOWN_SKIP_BUILD=
#
# --- Local dev only (`next dev`) ---
# /updown proxies to the game's Vite dev server (default http://127.0.0.1:5185).
UPDOWN_ORIGIN=
# Set to http://127.0.0.1:5186 to send /game-api to the game's standalone worker
# instead of the site's own route handlers. Ignored by production builds.
UPDOWN_WORKER_ORIGIN=
