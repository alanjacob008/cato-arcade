CLAW_HOSTED=1
PORT=8080
CLAW_SERVICE_ORIGIN=https://YOUR-BACKEND.example
CLAW_PUBLIC_ORIGIN=https://YOUR-CATO-SITE.example
CLAW_STATE_DIR=/data/claw-devnet
CLAW_DATABASE_URL=postgresql://USER:PASSWORD@YOUR-DATABASE.example/cato?sslmode=verify-full
# Generate a private 64-character hex capability in the provider's secret settings.
VRF_LOCAL_SESSION_TOKEN=
HELIUS_DEVNET_RPC_URL=
DEVNET_RPC_ORIGIN=
# Keep off until the upgraded cashier is initialized and its vault is funded.
CLAW_ENABLE_DEVNET_PAYMENTS=0

# --- Vercel container (no persistent disk) ---
# Seal the signer session into Postgres instead of CLAW_STATE_DIR. 64 hex characters. Never change it once set:
# the sealed signer state becomes unreadable.
CLAW_STATE_KEY=
# Read the database URL from another server-only variable instead of CLAW_DATABASE_URL,
# e.g. the Neon integration's direct connection (it is marked sensitive and cannot be copied).
CLAW_DATABASE_URL_ENV=DATABASE_URL_UNPOOLED

# Optional separate devnet funding contract. Keep disabled until owner setup.
CLAW_ENABLE_SPONSOR_TOPUPS=0
CLAW_SPONSOR_VAULT_OWNER=
CLAW_SPONSOR_FEE_WALLET=
# Server-only provider secret: 64-byte JSON keypair, never NEXT_PUBLIC_ or committed.
CLAW_SPONSOR_FEE_SECRET=
