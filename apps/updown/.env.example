# Copy to .env. All VITE_* values are public browser configuration.
VITE_APP_NAME=Up Down
VITE_APP_DESCRIPTION="Pick a market. Pick a side. Make your moment."
VITE_ORDERLY_BROKER_NAME=Up Down
VITE_ORDERLY_BROKER_ID=demo
VITE_DEPLOYMENT_ENV=testnet
VITE_DISABLE_MAINNET=true
VITE_DISABLE_TESTNET=false
VITE_ENABLED_MENUS=Trading,Portfolio
VITE_SEO_SITE_NAME=Up Down
VITE_SEO_SITE_URL=http://127.0.0.1:5185
VITE_WALLETCONNECT_PROJECT_ID=
VITE_SOLANA_RPC_URL=
# VITE_DEPLOYMENT_ENV must be mainnet or testnet (unset = testnet); any other value fails the build.
# For mainnet, use your registered broker, set environment=mainnet,
# disable mainnet=false and disable testnet=true (the build refuses mainnet otherwise). Match the Solana RPC network.
# Restart BOTH the web app and worker after environment changes.
# Do not add admin keys or wallet private keys. Round authorization happens in the UI.
# Inside the website (apps/web on Vercel) these VITE_* values come from the Vercel project env at
# build time instead; see the repo root .env.example. VITE_SEO_SITE_URL must be the production site URL.
# Optional, worker only (not VITE_*): journal rounds in the website Postgres instead of .runtime.
# Run `npm run migrate` in apps/updown first (applies db/*.sql). UPDOWN_JOURNAL_KEY is 64 hex chars (32 bytes)
# used to seal each round's trading key in the database; it is required with DATABASE_URL (the worker
# refuses to start without it). Use the same key as the website that shares the database.
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/cato_wrapped
# UPDOWN_JOURNAL_KEY=

# Served inside the main site (apps/web) under this path. Set to / to run the game on its own.
VITE_BASE_URL=/updown/
# Where the header links (Staking, Swap, Wrapped, wordmark) go. Empty = same origin.
VITE_MAIN_SITE_URL=
