# Local claw preview only. All backend values are server-side.
CLAW_DEVNET_LAB=1
HELIUS_DEVNET_RPC_URL=
DEVNET_RPC_ORIGIN=
# Optional existing wallet-controlled durable nonce; coordinate its use.
VRF_DURABLE_NONCE=
# Optional stable 64-character hex local admin capability. Never share with players.
VRF_LOCAL_SESSION_TOKEN=
# Existing site WalletContextProvider needs a valid RPC during prerendering.
NEXT_PUBLIC_RPC_URL=https://api.devnet.solana.com
# Optional hosted frontend proxy; exact HTTPS origin, server-only.
CLAW_BACKEND_ORIGIN=
# Local backend overrides; production variables are in deploy/claw-backend/.env.example.
CLAW_PORT=4322
CLAW_FRONTEND_PORT=4331
CLAW_STATE_DIR=
CLAW_DATABASE_URL=
CLAW_ENABLE_DEVNET_PAYMENTS=0

# Optional separate devnet funding contract. Keep disabled until owner setup.
CLAW_ENABLE_SPONSOR_TOPUPS=0
CLAW_SPONSOR_VAULT_OWNER=
CLAW_SPONSOR_FEE_WALLET=
# Server-only provider secret: 64-byte JSON keypair, never NEXT_PUBLIC_ or committed.
CLAW_SPONSOR_FEE_SECRET=
